@"
# HuggingFace API Key
# Get free token at: huggingface.co -> Settings -> Access Tokens
HUGGINGFACE_API_KEY=your_huggingface_token_here

# Gmail Configuration
# Get App Password at: myaccount.google.com -> Security -> App passwords
GMAIL_USERNAME=your_email@gmail.com
GMAIL_PASSWORD=your_16_char_app_password_here

# Database (default values - change in production)
DB_NAME=ats_db
DB_USER=postgres
DB_PASSWORD=your_db_password_here

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
"@ | Out-File -FilePath "C:\Users\hanas\Downloads\ATS-Project\.env.example" -Encoding utf8